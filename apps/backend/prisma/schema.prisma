// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
  DEACTIVATED
}

enum OtpType {
  REGISTRATION
  PASSWORD_RESET
  TWO_FACTOR
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  EXHAUSTED
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum MerchantStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  REJECTED
  DEACTIVATED
}

enum MerchantVerificationStatus {
  NOT_SUBMITTED
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  REQUIRES_RESUBMISSION
