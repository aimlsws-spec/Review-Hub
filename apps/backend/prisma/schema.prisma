model SupportTicket {
  id           String              @id @default(uuid())
  userId       String?
  merchantId   String?
  assignedToId String?
  subject      String
  description  String              @db.Text
  category     SupportCategory     @default(GENERAL)
  priority     SupportPriority     @default(MEDIUM)
  status       SupportTicketStatus @default(OPEN)
  resolvedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  user     User?            @relation(fields: [userId], references: [id])
  merchant Merchant?        @relation(fields: [merchantId], references: [id])
  messages SupportMessage[]

  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([userId])
  @@index([merchantId])
  @@index([category])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("support_tickets")
}

model SupportMessage {
  id           String   @id @default(uuid())
  ticketId     String
  senderId     String
  senderType   String
  message      String   @db.Text
  attachments  Json?
  internalNote Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ticket SupportTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@index([senderId])
  @@index([createdAt])
  @@map("support_messages")
}

model FraudFlag {
  id           String         @id @default(uuid())
  userId       String
  submissionId String?
  type         FraudFlagType
  riskLevel    FraudRiskLevel
  description  String?        @db.Text
  metadata     Json?
  resolved     Boolean        @default(false)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([riskLevel])
  @@index([resolved])
  @@map("fraud_flags")
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@map("admin_users")
}

model CMSPage {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  content         String        @db.LongText
  metaTitle       String?
  metaDescription String?       @db.Text
  status          CMSPageStatus @default(DRAFT)
  publishedAt     DateTime?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
  @@map("cms_pages")
}

model FAQ {
  id        String    @id @default(uuid())
  category  String
  question  String    @db.Text
  answer    String    @db.LongText
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([category])
  @@index([isActive])
  @@index([sortOrder])
  @@index([deletedAt])
  @@map("faqs")
}

model UploadedFile {
  id              String    @id @default(uuid())
  uploadedBy      String
  fileName        String
  originalName    String
  mimeType        String
  fileType        FileType  @default(OTHER)
  extension       String
  size            Int
  storageProvider String    @default("local")
  storagePath     String
  publicUrl       String?
  checksum        String?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  uploader User @relation("UploadedFileUser", fields: [uploadedBy], references: [id])

  @@index([uploadedBy])
  @@index([mimeType])
  @@index([fileType])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("uploaded_files")
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  module      String
  description String?  @db.Text
  ipAddress   String?
  device      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user User @relation("ActivityLogUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@map("activity_logs")
}

model AuditLog {
  id        String      @id @default(uuid())
  actorId   String
  actorType String
  entity    String
  entityId  String?
  action    AuditAction
  before    Json?
  after     Json?
  ipAddress String?
  userAgent String?     @db.Text
  createdAt DateTime    @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// BATCH 6 ENUMS
// ============================================================

enum ReportType {
  USER_REPORT
  CAMPAIGN_REPORT
  FINANCIAL_REPORT
  FRAUD_REPORT
  MERCHANT_REPORT
  PLATFORM_SUMMARY
}

enum ReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
}

enum JobType {
  CAMPAIGN_EXPIRY
  REWARD_PROCESSING
  ANALYTICS_AGGREGATION
  REPORT_GENERATION
  NOTIFICATION_DISPATCH
  FRAUD_SCAN
  WALLET_RECONCILIATION
  CLEANUP
  CUSTOM
}

enum AIResponseStatus {
  SUCCESS
  FAILED
  TIMEOUT
  RATE_LIMITED
}

enum SettingDataType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  ARRAY
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  DOWN
}

// ============================================================
// ANALYTICS MODULE
// ============================================================

model AnalyticsEvent {
  id            String    @id @default(uuid())
  eventName     String
  eventCategory String
  entityType    String?
  entityId      String?
  userId        String?
  merchantId    String?
  campaignId    String?
  metadata      Json?
  ipAddress     String?
  userAgent     String?   @db.Text
  platform      String?
  device        String?
  country       String?
  state         String?
  city          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  campaign Campaign? @relation("CampaignAnalyticsEvents", fields: [campaignId], references: [id])

  @@index([eventName])
  @@index([createdAt])
  @@index([campaignId])
  @@index([merchantId])
  @@index([userId])
  @@index([deletedAt])
  @@map("analytics_events")
}

model DailyAnalytics {
  id                 String    @id @default(uuid())
  date               DateTime  @unique @db.Date
  newUsers           Int       @default(0)
  activeUsers        Int       @default(0)
  campaignsCreated   Int       @default(0)
  campaignsCompleted Int       @default(0)
  submissions        Int       @default(0)
  rewardsPaid        Decimal   @default(0) @db.Decimal(12, 2)
  withdrawals        Decimal   @default(0) @db.Decimal(12, 2)
  revenue            Decimal   @default(0) @db.Decimal(12, 2)
  platformCommission Decimal   @default(0) @db.Decimal(12, 2)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@index([date])
  @@index([deletedAt])
  @@map("daily_analytics")
}

model MerchantAnalytics {
  id                    String    @id @default(uuid())
  merchantId            String    @unique
  totalCampaigns        Int       @default(0)
  totalParticipants     Int       @default(0)
  totalBudget           Decimal   @default(0) @db.Decimal(12, 2)
  totalSpent            Decimal   @default(0) @db.Decimal(12, 2)
  averageCompletionRate Decimal   @default(0) @db.Decimal(5, 4)
  totalRevenueGenerated Decimal   @default(0) @db.Decimal(12, 2)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([deletedAt])
  @@map("merchant_analytics")
}

model UserAnalytics {
  id                 String    @id @default(uuid())
  userId             String    @unique
  campaignsJoined    Int       @default(0)
  campaignsCompleted Int       @default(0)
  rewardsEarned      Decimal   @default(0) @db.Decimal(12, 2)
  referrals          Int       @default(0)
  withdrawals        Decimal   @default(0) @db.Decimal(12, 2)
  fraudFlags         Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([deletedAt])
  @@map("user_analytics")
}

// ============================================================
// REPORTS MODULE
// ============================================================

model Report {
  id          String       @id @default(uuid())
  name        String
  reportType  ReportType
  generatedBy String
  fileId      String?
  filters     Json?
  status      ReportStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  schedule ReportSchedule?

  @@index([reportType])
  @@index([generatedBy])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("reports")
}

model ReportSchedule {
  id         String          @id @default(uuid())
  reportId   String          @unique
  frequency  ReportFrequency
  nextRun    DateTime
  recipients Json
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?

  report Report @relation(fields: [reportId], references: [id])

  @@index([reportId])
  @@index([nextRun])
  @@index([active])
  @@index([deletedAt])
  @@map("report_schedules")
}

// ============================================================
// SCHEDULER MODULE
// ============================================================

model ScheduledJob {
  id             String    @id @default(uuid())
  jobName        String    @unique
  jobType        JobType
  cronExpression String
  enabled        Boolean   @default(true)
  lastRun        DateTime?
  nextRun        DateTime?
  retries        Int       @default(0)
  configuration  Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  executionLogs JobExecutionLog[]

  @@index([jobType])
  @@index([enabled])
  @@index([nextRun])
  @@index([deletedAt])
  @@map("scheduled_jobs")
}

model JobExecutionLog {
  id           String    @id @default(uuid())
  jobId        String
  startedAt    DateTime
  completedAt  DateTime?
  duration     Int?
  success      Boolean   @default(false)
  errorMessage String?   @db.Text
  logs         Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  job ScheduledJob @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@index([success])
  @@index([startedAt])
  @@index([deletedAt])
  @@map("job_execution_logs")
}

// ============================================================
// AI CONFIGURATION MODULE
// ============================================================

model AIProvider {
  id            String    @id @default(uuid())
  name          String    @unique
  provider      String
  apiEndpoint   String?
  model         String?
  enabled       Boolean   @default(true)
  priority      Int       @default(0)
  timeout       Int       @default(30000)
  configuration Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  models    AIModel[]
  prompts   AIPromptTemplate[]
  usageLogs AIUsageLog[]

  @@index([enabled])
  @@index([priority])
  @@index([deletedAt])
  @@map("ai_providers")
}

model AIModel {
  id          String    @id @default(uuid())
  providerId  String
  modelName   String
  version     String?
  maxTokens   Int       @default(4096)
  temperature Float     @default(0.7)
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  provider AIProvider @relation(fields: [providerId], references: [id])

  @@unique([providerId, modelName, version])
  @@index([providerId])
  @@index([enabled])
  @@index([deletedAt])
  @@map("ai_models")
}

model AIPromptTemplate {
  id         String    @id @default(uuid())
  providerId String
  name       String
  prompt     String    @db.LongText
  version    String    @default("1.0")
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  provider AIProvider @relation(fields: [providerId], references: [id])

  @@unique([providerId, name, version])
  @@index([providerId])
  @@index([active])
  @@index([deletedAt])
  @@map("ai_prompt_templates")
}

model AIUsageLog {
  id             String           @id @default(uuid())
  providerId     String
  userId         String?
  submissionId   String?
  tokens         Int              @default(0)
  latency        Int              @default(0)
  cost           Decimal          @default(0) @db.Decimal(10, 6)
  responseStatus AIResponseStatus @default(SUCCESS)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  provider AIProvider @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@index([createdAt])
  @@index([userId])
  @@index([submissionId])
  @@index([deletedAt])
  @@map("ai_usage_logs")
}

// ============================================================
// PLATFORM CONFIGURATION
// ============================================================

model SystemSetting {
  id          String          @id @default(uuid())
  key         String          @unique
  value       Json
  dataType    SettingDataType @default(STRING)
  category    String?
  description String?         @db.Text
  editable    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  @@index([category])
  @@index([editable])
  @@index([deletedAt])
  @@map("system_settings")
}

model FeatureFlag {
  id                String    @id @default(uuid())
  key               String    @unique
  description       String?   @db.Text
  enabled           Boolean   @default(false)
  rolloutPercentage Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@index([enabled])
  @@index([deletedAt])
  @@map("feature_flags")
}

model PlatformConfiguration {
  id                   String    @id @default(uuid())
  platformName         String    @default("ReviewHub")
  supportEmail         String?
  supportPhone         String?
  commissionPercentage Decimal   @default(0) @db.Decimal(5, 4)
  minimumWithdrawal    Decimal   @default(100) @db.Decimal(12, 2)
  maximumWithdrawal    Decimal   @default(50000) @db.Decimal(12, 2)
  maintenanceMode      Boolean   @default(false)
  appVersion           String    @default("1.0.0")
  apiVersion           String    @default("v1")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  @@index([deletedAt])
  @@map("platform_configuration")
}

// ============================================================
// SECURITY
// ============================================================

model ApiKey {
  id          String    @id @default(uuid())
  name        String
  key         String    @unique
  secret      String
  permissions Json?
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([key])
  @@index([active])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("api_keys")
}

model Webhook {
  id         String    @id @default(uuid())
  merchantId String
  url        String
  secret     String
  events     Json
  enabled    Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  merchant   Merchant          @relation(fields: [merchantId], references: [id])
  deliveries WebhookDelivery[]

  @@index([merchantId])
  @@index([enabled])
  @@index([deletedAt])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String    @id @default(uuid())
  webhookId    String
  payload      Json
  responseCode Int?
  success      Boolean   @default(false)
  attempts     Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  webhook Webhook @relation(fields: [webhookId], references: [id])

  @@index([webhookId])
  @@index([success])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("webhook_deliveries")
}

// ============================================================
// PLATFORM HEALTH
// ============================================================

model HealthCheck {
  id        String       @id @default(uuid())
  service   String
  status    HealthStatus @default(HEALTHY)
  latency   Int          @default(0)
  checkedAt DateTime     @default(now())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  @@index([service])
  @@index([status])
  @@index([checkedAt])
  @@index([deletedAt])
  @@map("health_checks")
}

model SystemMetric {
  id        String    @id @default(uuid())
  metric    String
  value     Decimal   @db.Decimal(20, 6)
  unit      String?
  timestamp DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([metric])
  @@index([timestamp])
  @@index([deletedAt])
  @@map("system_metrics")
}
