// ============================================================
// MODELS
// ============================================================

model User {
  id                  String     @id @default(uuid())
  firstName           String
  lastName            String
  email               String?    @unique
  phone               String?    @unique
  passwordHash        String?
  googleId            String?    @unique
  appleId             String?    @unique
  avatarUrl           String?
  status              UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  timezone            String?    @default("UTC")
  language            String?    @default("en")
  referralCode        String     @unique @default(uuid())
  referredById        String?
  isTwoFactorEnabled  Boolean    @default(false)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  referredBy             User?                    @relation("UserReferrals", fields: [referredById], references: [id])
  referrals              User[]                   @relation("UserReferrals")
  userRoles              UserRole[]
  sessions               UserSession[]
  otps                   Otp[]
  devices                Device[]
  loginHistories         LoginHistory[]
  merchant               Merchant?
  merchantTeams          MerchantTeam[]
  wallet                 UserWallet?
  bankAccounts           UserBankAccount[]
  taskSubmissions        TaskSubmission[]         @relation("TaskSubmissionUser")
  reviewedSubmissions    TaskSubmission[]         @relation("TaskSubmissionReviewer")
  rewards                Reward[]                 @relation("RewardUser")
  submissionFraudFlags   SubmissionFraudFlag[]    @relation("SubmissionFraudFlagUser")
  notifications          Notification[]
  notificationPreference NotificationPreference?
  referralsMade          Referral[]               @relation("ReferralReferrer")
  referralReceived       Referral?                @relation("ReferralReferredUser")
  supportTickets         SupportTicket[]
  kycDocuments           UserKycDocument[]
  fraudFlags             FraudFlag[]
  uploadedFiles          UploadedFile[]           @relation("UploadedFileUser")
  activityLogs           ActivityLog[]            @relation("ActivityLogUser")
  campaignParticipants   CampaignParticipant[]
  campaignAudits         CampaignAudit[]          @relation("CampaignAuditUser")
  campaignApprovals      CampaignApproval[]       @relation("CampaignApprovalReviewer")
  userAnalytics          UserAnalytics?
  gamificationProfile    UserGamificationProfile?
  badges                 UserBadge[]
  dailyRewardClaims      DailyRewardClaim[]
  redemptions            Redemption[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([referralCode])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([slug])
  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  module      String
  action      String
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@index([module])
  @@index([slug])
  @@map("permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserSession {
  id               String        @id @default(uuid())
  userId           String
  refreshTokenHash String
  ipAddress        String?
  deviceId         String?
  userAgent        String?       @db.Text
  status           SessionStatus @default(ACTIVE)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  device Device? @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([status])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Otp {
  id          String    @id @default(uuid())
  userId      String
  type        OtpType
  code        String
  status      OtpStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type, status])
  @@index([expiresAt])
  @@map("otps")
}

model Device {
  id           String         @id @default(uuid())
  userId       String
  name         String?
  platform     DevicePlatform
  os           String?
  appVersion   String?
  pushToken    String?        @unique
  fingerprint  String?
  isActive     Boolean        @default(true)
  lastSeenAt   DateTime?
  // Basic fraud-risk signals — isRooted/isEmulator are self-reported by the
  // client (a server can't reliably detect either from HTTP alone); vpnSuspected
  // is a lightweight server-side header heuristic, not a commercial IP-intel
  // lookup. riskScore is a simple weighted sum of the three, not a real model.
  isRooted     Boolean        @default(false)
  isEmulator   Boolean        @default(false)
  vpnSuspected Boolean        @default(false)
  riskScore    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user         User           @relation(fields: [userId], references: [id])
  sessions     UserSession[]
  loginHistory LoginHistory[]

  @@unique([userId, fingerprint])
  @@index([userId])
  @@index([fingerprint])
  @@index([riskScore])
  @@map("devices")
}

model LoginHistory {
  id            String    @id @default(uuid())
  userId        String
  deviceId      String?
  ipAddress     String?
  browser       String?
  location      String?
  isSuccess     Boolean   @default(true)
  failureReason String?
  loginAt       DateTime  @default(now())
  logoutAt      DateTime?

  user   User    @relation(fields: [userId], references: [id])
  device Device? @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@index([loginAt])
  @@index([isSuccess])
  @@map("login_history")
}

model Country {
  id       String  @id @default(uuid())
  name     String  @unique
  code     String  @unique
  dialCode String?
  isActive Boolean @default(true)

  states    State[]
  merchants Merchant[]

  @@map("countries")
}

model State {
  id        String  @id @default(uuid())
  countryId String
  name      String
  code      String?
  isActive  Boolean @default(true)

  country   Country    @relation(fields: [countryId], references: [id])
  cities    City[]
  merchants Merchant[]

  @@unique([countryId, name])
  @@index([countryId])
  @@map("states")
}

model City {
  id       String  @id @default(uuid())
  stateId  String
  name     String
  isActive Boolean @default(true)

  state     State      @relation(fields: [stateId], references: [id])
  merchants Merchant[]

  @@unique([stateId, name])
  @@index([stateId])
  @@map("cities")
}

model Merchant {
  id                 String                     @id @default(uuid())
  userId             String                     @unique
  businessName       String
  legalBusinessName  String?
  businessType       String?
  businessCategory   String?
  gstNumber          String?                    @unique
  panNumber          String?                    @unique
  registrationNumber String?
  website            String?
  email              String                     @unique
  phone              String                     @unique
  addressLine1       String?
  addressLine2       String?
  countryId          String?
  stateId            String?
  cityId             String?
  postalCode         String?
  logoUrl            String?
  description        String?                    @db.Text
  verificationStatus MerchantVerificationStatus @default(NOT_SUBMITTED)
  status             MerchantStatus             @default(PENDING_VERIFICATION)
  creditBalance      Decimal                    @default(0) @db.Decimal(12, 2)
  commissionRate     Decimal                    @default(0) @db.Decimal(5, 4)
  kycCompletedAt     DateTime?
  verifiedAt         DateTime?
  verifiedBy         String?
  rejectedReason     String?                    @db.Text
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  deletedAt          DateTime?

  user              User                  @relation(fields: [userId], references: [id])
  country           Country?              @relation(fields: [countryId], references: [id])
  state             State?                @relation(fields: [stateId], references: [id])
  city              City?                 @relation(fields: [cityId], references: [id])
  documents         MerchantDocument[]
  bankAccounts      MerchantBankAccount[]
  teamMembers       MerchantTeam[]
  invitations       MerchantInvitation[]
  wallet            MerchantWallet?
  campaigns         Campaign[]
  supportTickets    SupportTicket[]
  merchantAnalytics MerchantAnalytics?
  webhooks          Webhook[]
  reviews           Review[]
  settlements       Settlement[]
  invoices          Invoice[]

  @@index([businessName])
  @@index([email])
  @@index([phone])
  @@index([gstNumber])
  @@index([panNumber])
  @@index([verificationStatus])
  @@index([status])
  @@index([countryId])
  @@index([stateId])
  @@index([cityId])
  @@index([deletedAt])
  @@map("merchants")
}

model MerchantDocument {
  id                 String                     @id @default(uuid())
  merchantId         String
  documentType       MerchantDocumentType
  fileUploadId       String?
  documentNumber     String?
  verificationStatus DocumentVerificationStatus @default(PENDING)
  verifiedBy         String?
  verifiedAt         DateTime?
  rejectionReason    String?                    @db.Text
  expiresAt          DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  deletedAt          DateTime?

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([documentType])
  @@index([verificationStatus])
  @@index([deletedAt])
  @@map("merchant_documents")
}

model UserKycDocument {
  id                 String                     @id @default(uuid())
  userId             String
  documentType       UserDocumentType
  fileUploadId       String?
  documentNumber     String?
  verificationStatus DocumentVerificationStatus @default(PENDING)
  verifiedBy         String?
  verifiedAt         DateTime?
  rejectionReason    String?                    @db.Text
  expiresAt          DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  deletedAt          DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([documentType])
  @@index([verificationStatus])
  @@index([deletedAt])
  @@map("user_kyc_documents")
}

model MerchantBankAccount {
  id                 String                 @id @default(uuid())
  merchantId         String
  bankName           String
  accountHolderName  String
  accountNumber      String
  ifscCode           String
  branch             String?
  upiId              String?
  isPrimary          Boolean                @default(false)
  verificationStatus BankVerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?

  merchant       Merchant                @relation(fields: [merchantId], references: [id])
  refundRequests MerchantRefundRequest[]

  @@unique([merchantId, accountNumber, ifscCode])
  @@index([merchantId])
  @@index([verificationStatus])
  @@index([deletedAt])
  @@map("merchant_bank_accounts")
}

model MerchantTeam {
  id          String             @id @default(uuid())
  merchantId  String
  userId      String
  role        MerchantTeamRole   @default(VIEWER)
  permissions Json?
  status      MerchantTeamStatus @default(ACTIVE)
  invitedBy   String?
  joinedAt    DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  merchant Merchant @relation(fields: [merchantId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([merchantId, userId])
  @@index([merchantId])
  @@index([userId])
  @@index([status])
  @@index([deletedAt])
  @@map("merchant_team")
}

model MerchantInvitation {
  id          String           @id @default(uuid())
  merchantId  String
  email       String
  role        MerchantTeamRole @default(VIEWER)
  inviteToken String           @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  status      InvitationStatus @default(PENDING)
  invitedBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, email])
  @@index([merchantId])
  @@index([email])
  @@index([inviteToken])
  @@index([status])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("merchant_invitations")
}

enum ReviewSource {
  GOOGLE
  FACEBOOK
  ZOMATO
  SWIGGY
  TRIPADVISOR
  WEBSITE
  OTHER
}

enum ReviewStatus {
  PENDING
  REPLIED
  FLAGGED
  RESOLVED
}

/// A review a merchant received on an external platform (Google, Facebook, etc.),
/// logged into VIRAL KAR so the merchant can track and reply to it in one place.
/// Not synced live from those platforms — entered manually until a real
/// platform-API integration is built.
model Review {
  id            String       @id @default(uuid())
  merchantId    String
  customerName  String
  customerEmail String?
  source        ReviewSource
  rating        Int
  title         String?
  body          String       @db.Text
  status        ReviewStatus @default(PENDING)
  reply         String?      @db.Text
  repliedAt     DateTime?
  repliedBy     String?
  reviewedAt    DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([status])
  @@index([source])
  @@index([rating])
  @@index([customerEmail])
  @@index([deletedAt])
  @@map("reviews")
}

model Campaign {
  id                  String             @id @default(uuid())
  merchantId          String
  title               String
  slug                String             @unique
  shortDescription    String?
  description         String             @db.Text
  thumbnailUrl        String?
  bannerUrl           String?
  campaignType        CampaignType
  status              CampaignStatus     @default(DRAFT)
  visibility          CampaignVisibility @default(PUBLIC)
  priority            CampaignPriority   @default(NORMAL)
  rewardType          RewardType         @default(CASH)
  rewardAmount        Decimal            @db.Decimal(12, 2)
  totalBudget         Decimal            @db.Decimal(12, 2)
  reservedBudget      Decimal            @default(0) @db.Decimal(12, 2)
  spentBudget         Decimal            @default(0) @db.Decimal(12, 2)
  remainingBudget     Decimal            @db.Decimal(12, 2)
  maxParticipants     Int?
  currentParticipants Int                @default(0)
  minimumUserLevel    Int                @default(0)
  minimumFollowers    Int                @default(0)
  minimumAge          Int?
  maximumAge          Int?
  targetGender        TargetGender       @default(ALL)
  targetCountries     Json?
  targetStates        Json?
  targetCities        Json?
  startAt             DateTime?
  endAt               DateTime?
  publishedAt         DateTime?
  approvedAt          DateTime?
  approvedBy          String?
  rejectedReason      String?            @db.Text
  autoApprove         Boolean            @default(false)
  aiThreshold         Float              @default(0.8)
  featured            Boolean            @default(false)
  featuredUntil       DateTime?
  metadata            Json?
  createdBy           String
  updatedBy           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  merchant        Merchant                  @relation(fields: [merchantId], references: [id])
  tasks           CampaignTask[]
  media           CampaignMedia[]
  targets         CampaignTarget[]
  categories      CampaignCategoryMapping[]
  tags            CampaignTagMap[]
  audits          CampaignAudit[]
  approvals       CampaignApproval[]
  participants    CampaignParticipant[]
  rewards         Reward[]
  analytics       CampaignAnalytics?
  analyticsEvents AnalyticsEvent[]          @relation("CampaignAnalyticsEvents")

  @@index([merchantId])
  @@index([status])
  @@index([campaignType])
  @@index([visibility])
  @@index([featured])
  @@index([startAt])
  @@index([endAt])
  @@index([approvedAt])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("campaigns")
}

model CampaignTask {
  id                 String           @id @default(uuid())
  campaignId         String
  title              String
  description        String?          @db.Text
  instructions       String?          @db.Text
  taskType           TaskType
  verificationType   VerificationType @default(AI)
  taskOrder          Int              @default(0)
  rewardAmount       Decimal?         @db.Decimal(12, 2)
  required           Boolean          @default(true)
  minimumTimeSeconds Int              @default(0)
  proofRequired      Boolean          @default(true)
  proofType          EvidenceType?
  configuration      Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  campaign    Campaign         @relation(fields: [campaignId], references: [id])
  submissions TaskSubmission[]

