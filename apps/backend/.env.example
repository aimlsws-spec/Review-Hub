# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# Values below marked "(docker-compose)" already match the credentials in
# ../../docker-compose.yml — leave them as-is if you're using
# `docker compose up` for local MySQL/Redis/RabbitMQ.
#
# Every third-party integration below (SMTP, Twilio, Firebase, Google/Apple
# login, Razorpay, cloud LLM providers, Sentry, Datadog) is OPTIONAL. The app
# is designed to run and be testable locally without any of them configured
# or paid for — leave a block blank and the feature it powers degrades
# gracefully (e.g. OTP falls back to logging instead of sending SMS).

# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=VIRAL KAR
APP_VERSION=1.0.0
APP_PORT=3000
APP_HOST=0.0.0.0
API_PREFIX=api
API_VERSION=1

# ── Database ─────────────────────────────────────────────────────────
# If you already have a native MySQL running locally on the default port
# (common — check with `docker compose ps` vs. your OS's service list before
# assuming), point this at it directly, e.g.:
#   DATABASE_URL=mysql://root:yourpassword@localhost:3306/viral_kar
#
# Or, to use the isolated MySQL from `docker compose up` instead (mapped to
# 3307 specifically so it never collides with a native install on 3306):
DATABASE_URL=mysql://viral_kar:viral_kar_dev@localhost:3307/viral_kar
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=30000

# ── JWT — generate real random strings, don't reuse these in production ─
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-32-chars-min
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-32-chars-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Redis (docker-compose) ──────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_SECONDS=3600

# ── Email (optional — leave blank to skip sending emails locally) ──────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=VIRAL KAR
SMTP_FROM_EMAIL=noreply@example.com

# ── OTP ──────────────────────────────────────────────────────────────
OTP_PROVIDER=log
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ── Twilio (optional — SMS/WhatsApp OTP and alerts) ─────────────────────
# OTP always emails when the account has an email; these add SMS delivery
# too (needed for phone-only accounts, which otherwise get no OTP at all).
# Leave blank to degrade gracefully — SmsService just logs a warning.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# WhatsApp sender — enabled separately in the Twilio console, same account.
TWILIO_WHATSAPP_FROM_NUMBER=

# ── File storage — local disk, per project convention (never S3) ───────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_FILE_SIZE_MB=10
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ── Firebase (optional — push notifications) ────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ── Google login (optional) ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ── Apple login (optional) ──────────────────────────────────────────
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/apple/callback

# ── Razorpay (optional — use test-mode keys, never commit live keys) ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_X_ACCOUNT_NUMBER=

# ── Platform GST (optional — placeholders until the company registers for GST) ──
PLATFORM_GST_NUMBER=
PLATFORM_GST_RATE_PERCENT=18

# ── AI — local/free by default (Ollama), cloud providers optional ──────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=30000
BEDROCK_REGION=
BEDROCK_MODEL_ID=
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=30000
AI_CONFIDENCE_THRESHOLD=0.85

# ── AI Services (apps/ai-services) — must match its own .env ───────────
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=ai-service-dev
AI_SERVICE_API_SECRET=dev-only-secret-change-me
AI_SERVICE_TIMEOUT_MS=30000

# ── RabbitMQ (docker-compose) ───────────────────────────────────────
RABBITMQ_URL=amqp://viral_kar:viral_kar_dev@localhost:5672
RABBITMQ_QUEUE_SUBMISSIONS=submissions
RABBITMQ_QUEUE_NOTIFICATIONS=notifications
RABBITMQ_QUEUE_REWARDS=rewards
RABBITMQ_PREFETCH=10

# ── Rate limiting ────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_FILE_ENABLED=false
LOG_FILE_PATH=./logs
LOG_FILE_MAX_SIZE=20m
LOG_FILE_MAX_FILES=14d

# ── Observability (optional) ────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
DATADOG_API_KEY=
DATADOG_APP_KEY=

# ── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
CORS_CREDENTIALS=true

# ── Swagger ──────────────────────────────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_TITLE=VIRAL KAR API
SWAGGER_DESCRIPTION=VIRAL KAR backend API documentation
SWAGGER_PATH=api/docs
