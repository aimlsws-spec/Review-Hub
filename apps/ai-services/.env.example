# Backend integration — matches apps/backend/prisma/seed.ts's dev seed.
BACKEND_BASE_URL=http://localhost:3000/api/v1
AI_SERVICE_API_KEY=ai-service-dev
AI_SERVICE_API_SECRET=dev-only-secret-change-me

ENGINE_NAME=heuristic-ocr
ENGINE_MODEL=v1
POLL_INTERVAL_SECONDS=5

MIN_CONFIDENCE=0.85
MAX_FRAUD_SCORE=0.3

# OCR — free, local. Requires the Tesseract binary itself to be installed;
# set TESSERACT_CMD if it isn't on PATH. Leave OCR_ENABLED=true even without
# Tesseract installed — it just auto-disables and logs a warning.
OCR_ENABLED=true
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# LLM-backed explanation text — free, local, via Ollama (https://ollama.com).
# No paid provider is used anywhere in this service. Disabled by default;
# verification works fully without it.
LLM_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
