# Viralkar mobile app settings (read by lib/core/config/app_config.dart).
#
# Copy this file to .env (same folder) and change the values for your setup. .env is not committed to git.
# A value passed as --dart-define at build or run time wins over this file, e.g. for a release build.
#
# Everything here is bundled inside the app, and anyone who downloads the app can read it. Put public values only
# (addresses, client IDs), never a secret key or password: those belong in the backend's .env.

# Where the backend API is.
#   Android emulator:                     http://10.0.2.2:3000/api/v1
#   Real phone over USB (adb reverse):    http://localhost:3000/api/v1
#     (run once per connection: adb reverse tcp:3000 tcp:3000)
#   Real phone over Wi-Fi:                http://<your PC's IP, e.g. 192.168.29.51>:3000/api/v1
#   Live server:                          https://api.viralkar.com/api/v1
# Left empty, the emulator address is used on Android.
API_BASE_URL=http://localhost:3000/api/v1

# Network logging in the debug console. Set to false for release builds.
ENABLE_LOGGING=true

# Google sign-in: the Web OAuth client ID. Must equal the backend's GOOGLE_CLIENT_ID.
# Left empty, the Viralkar project's client ID built into the app is used.
GOOGLE_SERVER_CLIENT_ID=

# Apple sign-in on Android (not set up yet; leave empty).
APPLE_SERVICE_ID=
APPLE_REDIRECT_URI=
