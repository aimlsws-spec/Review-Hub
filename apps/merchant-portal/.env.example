# Copy this file to .env and adjust if your backend isn't on the default port.
#   cp .env.example .env

VITE_API_URL=http://localhost:3000/api/v1

# Optional — only needed to test the wallet recharge/checkout flow locally.
# Use a Razorpay TEST-mode key (starts with rzp_test_), never a live key.
VITE_RAZORPAY_KEY_ID=

# Shows the "Simulate payment (dev)" wallet button, which adds funds with no real payment.
# Set true only when the backend runs PAYMENT_PROVIDER=mock; with Razorpay the backend answers 404.
# Leave false for production.
VITE_ENABLE_PAYMENT_SIMULATION=false
